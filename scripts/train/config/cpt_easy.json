{
  "_doc": "Easy CPT run: the settings of docs/prepare_cpt_training_pipeline.md (sections 4, 6, 8). Paths are relative to the repo root. Key reference: scripts/train/README.md.",

  "model": "Qwen/Qwen3.5-4B-Base",
  "data_dir": "data/processed/cpt/easy",
  "probe_dir": "data/probes/easy",
  "sample_prompts": "scripts/train/config/sample_prompts.json",
  "output_dir": "outputs/cpt-easy-v1",
  "run_name": "cpt-easy-v1",
  "report_to": "wandb",
  "wandb_project": "sinhala-mmlu-cpt",
  "hub_repo": null,

  "seq_len": 2048,
  "limit_blocks_per_epoch": null,
  "val_limit_blocks": null,
  "global_batch": 32,
  "per_device_train_batch_size": 2,
  "per_device_eval_batch_size": 2,

  "learning_rate": 2e-5,
  "warmup_ratio": 0.05,
  "decay_ratio": 0.2,
  "min_lr_ratio": 0.1,
  "optim": "adamw_torch_8bit",
  "optim_args": "bf16_stochastic_round=True",
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "weight_decay": 0.1,
  "max_grad_norm": 1.0,
  "bf16": true,
  "gradient_checkpointing": true,
  "seed": 42,

  "eval_steps": 25,
  "save_steps": 25,
  "save_total_limit": 2,

  "probe_steps": 50,
  "probe_at_start": true,
  "probe_full_at_start": true,
  "probe_limit": null,
  "sample_max_new_tokens": 100,

  "check1_fraction": 0.2,
  "replay_loss_tolerance": 0.05,
  "gate_action": "alert",

  "smoke_steps": 10,
  "smoke_probe_limit": 100,
  "allow_slow_kernels": false
}
